# =========================
# DeepSeek / LLM
# =========================
# 安全建议：
# 1) 推荐把敏感密钥放到系统环境变量，不直接写入 .env 明文
# 2) .env 中可留空，程序会优先读取系统环境变量
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 路由模型与总结模型
ROUTER_MODEL=deepseek-chat
SYNTHESIZER_MODEL=deepseek-reasoner

# 模型采样参数
ROUTER_TEMPERATURE=0.1
SYNTHESIZER_TEMPERATURE=0.7
SYNTHESIZER_MAX_TOKENS=4096
MODEL_REQUEST_TIMEOUT_SEC=60
MODEL_MAX_RETRIES=2

# =========================
# Dify
# =========================
DIFY_APP_API_KEY=
DIFY_DATASET_API_KEY=

# 如果你本机端口或域名不同，改这里
DIFY_BASE_URL=http://localhost

# 可选：手动覆盖完整接口地址。不填则由 DIFY_BASE_URL 推导
# DIFY_WORKFLOW_URL=http://localhost/v1/workflows/run

# 可选：知识库 ID（不填使用代码默认值）
DIFY_DATASET_ID=7f5cbb69-1ff7-4f2e-a3bd-baaddf10847c

# 可选：手动覆盖知识库检索地址。不填则由 DIFY_BASE_URL + DIFY_DATASET_ID 推导
# DIFY_RETRIEVAL_URL=http://localhost/v1/datasets/<your_dataset_id>/retrieve

# =========================
# Agent Behavior
# =========================
MAX_CRITIC_RETRIES=3
AGENT_DB_PATH=databank/agent_chat_history.db

# =========================
# FastAPI Gateway (WeekD)
# =========================
# 是否启用 API Key 鉴权（仅对 /v1/* 生效）
API_AUTH_ENABLED=false
# 当 API_AUTH_ENABLED=true 时必须设置
API_AUTH_KEY=
# 每分钟每IP请求上限（仅对 /v1/* 生效）
API_RATE_LIMIT_PER_MIN=60
# CORS 白名单，多个域名用逗号分隔，默认 *
API_CORS_ORIGINS=*

# =========================
# Tool Runtime
# =========================
TOOL_TIMEOUT_SEC=15
TOOL_RETRY_MAX=3
TOOL_RETRY_BACKOFF=1.0

# =========================
# Voice (Week4)
# =========================
# 默认关闭，开启后需要配置 ASR/TTS 接口与密钥
VOICE_ENABLED=false
VOICE_TIMEOUT_SEC=30

# OpenAI-compatible ASR endpoint
# 示例: https://api.openai.com/v1/audio/transcriptions
VOICE_ASR_URL=
VOICE_ASR_API_KEY=
VOICE_ASR_MODEL=whisper-1
VOICE_ASR_LANGUAGE=zh

# OpenAI-compatible TTS endpoint
# 示例: https://api.openai.com/v1/audio/speech
VOICE_TTS_URL=
VOICE_TTS_API_KEY=
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=alloy
VOICE_AUTO_TTS_DEFAULT=true

# =========================
# Vision (Week5)
# =========================
# 默认关闭，开启后需要配置 Vision 接口与密钥
VISION_ENABLED=false
VISION_TIMEOUT_SEC=45

# OpenAI-compatible Vision chat endpoint
# 示例: https://api.openai.com/v1/chat/completions
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_AUTO_ANALYZE_DEFAULT=true

# =========================
# Actions (Week6)
# =========================
# 审计日志输出路径（jsonl），默认项目根目录 audit.log
ACTION_AUDIT_LOG_PATH=audit.log
# 自动执行上限风险级别: low / medium / high
ACTION_AUTO_EXECUTE_MAX_RISK=low

# =========================
# Memory (Week7)
# =========================
# 用户偏好记忆存储路径（按会话ID保存）
USER_PROFILE_STORE_PATH=databank/user_profiles.json

# =========================
# Sub Agent Logging
# =========================
DEBUG_LOG_ENABLED=false
# 可选: DEBUG / INFO / WARNING / ERROR
AGENT_LOG_LEVEL=INFO

# =========================
# MultiModal Sub Agent Paper Fetch
# =========================
PAPER_AUTO_FETCH_ON_RUN=true
PAPER_FETCH_LIMIT_PER_RUN=10
PAPER_FETCH_LOOP_COUNT=10
PAPER_FETCH_INTERVAL_MINUTES=30
PAPER_FETCH_QUERY=all:multimodal OR all:"vision-language model" OR all:"VLM"
PAPER_DOWNLOAD_PDF_ON_RUN=true
PAPER_PDF_DOWNLOAD_TIMEOUT_SEC=30
PAPER_PDF_DOWNLOAD_RETRIES=2
PAPER_ONLY_USE_LATEST_BATCH=true
MULTIMODAL_AGENT_NEWS_LIMIT=0
MULTIMODAL_AGENT_TOP_K=10
